# Copy to .env and adjust. libpq variables are read by psql, ogr2ogr, raster2pgsql (via psql),
# pg_dump and the Python code alike.
PGHOST=localhost
PGPORT=5433
PGDATABASE=ews
PGUSER=ews
PGPASSWORD=ews

# Where downloaded/derived data lives (relative to repo root). `make demo` overrides this
# with data/synthetic so offline test data never mixes with real downloads.
EWS_DATA_DIR=data

# Event window to analyse. Default brackets the 30-31 July 2022 Mbale flash floods.
EWS_EVENT_START=2022-07-20
EWS_EVENT_END=2022-08-05

# Climatology baseline and seasonal window (+/- days around the event window).
EWS_CLIM_YEARS=1991-2020
EWS_CLIM_HALF_WINDOW=15

# Boundary source: hdx (OCHA COD-AB, admin 2 = district) or gadm.
EWS_DISTRICT_SOURCE=hdx

# CAP message metadata. Replace with the national authority's registered sender before any
# real use. `Actual` status is refused without --approved-by.
EWS_CAP_SENDER=ews-demo@example.org
EWS_CAP_SENDER_NAME=Uganda national EWS demonstration (unofficial)
EWS_CAP_IDENTIFIER_PREFIX=UG-EWS-DEMO
EWS_CAP_WEB=https://example.org/ews-demo
EWS_CAP_CONTACT=Duty officer, national situation room (demo)
